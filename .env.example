# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used in the checker User-Agent and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key (sb_secret_...): bypasses row-level security.
# Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only: shared secret the scheduler sends to /api/cron/check
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=generate-a-long-random-string

# Server-only: Resend API key for alert emails
RESEND_API_KEY=your-resend-key

# Optional: sender for alert emails. Leave unset to use Resend's test sender
# (onboarding@resend.dev), which only delivers to your Resend account's email.
# After verifying a domain in Resend, e.g.: Online Na Ba? <alerts@yourdomain.com>
ALERTS_FROM=

# Optional: where the daily health check emails problems (missing cron job,
# gaps in checks). Without a verified domain in Resend, this must be the email
# your Resend account is registered with.
HEALTH_EMAIL=
